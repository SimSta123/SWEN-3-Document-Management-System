@baseUrl = http://localhost:8081
# Replace these IDs with the values returned by the create requests below.
@projectId = 1
@documentId = 1

### Create a project (201)
POST {{baseUrl}}/projects
Content-Type: application/json

{"name":"SWEN3","description":"Course documents"}

### List projects (200)
GET {{baseUrl}}/projects

### Create a document metadata record, without uploading a file (201)
POST {{baseUrl}}/documents
Content-Type: application/json

{"title":"Sprint 1 notes"}

### Upload a PDF and publish its document-created message (201)
# Replace ./notes.pdf with a local PDF. The title part is optional.
POST {{baseUrl}}/documents
Content-Type: multipart/form-data; boundary=swen3-pdf-upload

--swen3-pdf-upload
Content-Disposition: form-data; name="title"

Course notes
--swen3-pdf-upload
Content-Disposition: form-data; name="file"; filename="notes.pdf"
Content-Type: application/pdf

< ./notes.pdf
--swen3-pdf-upload--

### List all saved documents, including unassigned ones (200)
GET {{baseUrl}}/documents

### Read one saved document (200)
GET {{baseUrl}}/documents/{{documentId}}

### Unknown document (404)
GET {{baseUrl}}/documents/9223372036854775807

### Assign the document; repeating this request does not duplicate it (200)
PUT {{baseUrl}}/projects/{{projectId}}/documents/{{documentId}}

### List the project's documents (200)
GET {{baseUrl}}/projects/{{projectId}}/documents

### Reject a blank project name (400)
POST {{baseUrl}}/projects
Content-Type: application/json

{"name":" "}

### Unknown project (404)
GET {{baseUrl}}/projects/9223372036854775807/documents
